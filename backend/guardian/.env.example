# Copy this template to backend/guardian/.env and fill in your own key.
# Never commit the resulting .env file.
OPENAI_API_KEY=

# Explicit model for the production GuardianClassic agents.
# This does not change the extension's direct model or benchmark campaigns.
MODEL=gpt-4o-mini

# Disable CrewAI telemetry/tracing before importing the backend.
OTEL_SDK_DISABLED=true
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_TRACKING=true
CREWAI_TRACING_ENABLED=false

# Optional: override the domain-registration SQLite cache location.
# GUARDIAN_CACHE_DB=/absolute/path/to/registration_cache.db
